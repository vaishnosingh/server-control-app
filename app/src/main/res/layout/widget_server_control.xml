<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="13dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- App Launcher Icon Badge (Explicit App Launch only if user taps this badge) -->
        <FrameLayout
            android:id="@+id/widget_app_icon_badge"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_icon_badge">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/widget_ic_terminal"
                android:contentDescription="Server App" />
        </FrameLayout>

        <!-- Device & Node Info (Tapping this refreshes status, does NOT open app) -->
        <LinearLayout
            android:id="@+id/widget_header_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_device_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Server"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_node_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="debian"
                android:textColor="#9ca3af"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Status Chip Badge -->
        <LinearLayout
            android:id="@+id/widget_status_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_checking"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp">

            <ImageView
                android:id="@+id/widget_status_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/widget_dot_gray"
                android:contentDescription="Status Dot" />

            <TextView
                android:id="@+id/widget_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="CHECKING"
                android:textColor="#9ca3af"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Refresh Button Container (Large 32x32dp touch target) -->
        <FrameLayout
            android:id="@+id/widget_btn_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_refresh_bg">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/widget_ic_refresh"
                android:contentDescription="Refresh" />
        </FrameLayout>
    </LinearLayout>

    <!-- Sleek Horizontal Divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="9dp"
        android:background="#222228" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_power_on"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_green"
            android:gravity="center"
            android:text="⚡ POWER ON"
            android:textColor="#4ade80"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_reboot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_amber"
            android:gravity="center"
            android:text="🔄 REBOOT"
            android:textColor="#fbbf24"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_power_off"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_red"
            android:gravity="center"
            android:text="🛑 OFF"
            android:textColor="#f87171"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtitle / Last Update message -->
    <TextView
        android:id="@+id/widget_footer_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Checking server status..."
        android:textColor="#71717a"
        android:textSize="10sp" />
</LinearLayout>
